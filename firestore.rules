rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isDoctorOf(doctorId) {
      return signedIn() && role() == 'doctor' &&
        request.auth.token.doctorId == doctorId;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid &&
        !('role' in request.resource.data);
      allow update: if signedIn() &&
        (request.auth.uid == uid || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'email', 'uid']);
      allow delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /bookedSlots/{slotId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /bookedSlots/{slotId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin() ||
         isDoctorOf(resource.data.doctorId));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
