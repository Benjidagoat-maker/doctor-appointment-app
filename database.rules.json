{
  "rules": {
    ".read": false,
    ".write": false,
    "doctors_presence": {
      "$doctorId": {
        ".read": "auth != null"
      }
    },
    "waiting_room": {
      "$doctorId": {
        ".read": "auth != null"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
