rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    
    // Super Admin bootstrap rule: kenjirobenji@gmail.com
    function isSuperAdmin() {
      return signedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'kenjirobenji@gmail.com';
    }
    
    function isAdmin() {
      return signedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin')
      );
    }

    match /users/{uid} {
      // Admins can read all registered users; regular users can read their own
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      
      // Any authenticated user can create their own profile document
      allow create: if signedIn() && request.auth.uid == uid;

      // Users can update their profile / presence; Admins can update roles
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      
      allow delete: if isAdmin();
    }

    match /doctors/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    match /appointments/{id} {
      // Patients read their own appointments; Admins have complete visibility across all doctors & specialties
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Patients book future appointments; Admins can manually book/schedule any appointment
      allow create: if signedIn();

      // Admins can edit any appointment; Patients can only cancel their own
      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['booked', 'cancelled', 'Cancelled']
        )
      );

      // Only Admins can delete appointment records from the system
      allow delete: if isAdmin();
    }

    match /otp_verifications/{email} {
      // 2-Step OTP verification codes
      allow read, write: if signedIn();
    }
  }
}
